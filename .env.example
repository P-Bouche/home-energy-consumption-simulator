# Copy to .env and adjust. Never commit real credentials.

# PostgreSQL/PostGIS (matches infrastructure/docker/docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hecs
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hecs

# NestJS API (apps/api)
API_PORT=3000
# Use DATABASE_URL=memory:// to run the API with an in-memory repository
# (local demos / e2e tests without Docker).
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=5242880
MIGRATIONS_DIR=infrastructure/postgres/migrations

# Web (apps/web, Vite dev server)
WEB_PORT=5173
